# ==========================================================
# OCR 引擎：rapid(默认内置) | paddle | easy | tesseract | http
#   rapid      -> pip 包 rapidocr-onnxruntime，CPU 可直接跑
#   paddle     -> pip 包 paddleocr（需 paddlepaddle，较重）
#   tesseract  -> 外部开源程序 Tesseract，走命令行
#   http       -> 外部开源 OCR 服务（Umi-OCR / 自建服务 / Docker 容器）
# ==========================================================
OCR_ENGINE=rapid
OCR_LANG=ch
OCR_MIN_SCORE=0.5

# ---- OCR_ENGINE=tesseract 时生效 ----
# tesseract 可执行文件路径，留空则使用系统 PATH 中的 tesseract
TESSERACT_CMD=
# tessdata 目录，中文需要 chi_sim.traineddata
TESSDATA_PREFIX=
TESSERACT_LANG=eng+chi_sim

# ---- OCR_ENGINE=http 时生效 ----
# 外部开源 OCR 服务的地址，例如 Umi-OCR: http://127.0.0.1:1224/api/ocr
OCR_HTTP_URL=
OCR_HTTP_TIMEOUT=60
# 额外随请求发送的 JSON 字段（可选），例如 {"options": {"data.format": "dict"}}
OCR_HTTP_EXTRA=

# ==========================================================
# 翻译引擎：google(默认) | youdao | deepl | mock
#   google -> deep-translator 免费后端，无需 key
#   mock   -> 原样返回，用于离线联调
# ==========================================================
TRANSLATOR=google

YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=

DEEPL_AUTH_KEY=
DEEPL_FREE=true
